# Configure one TMDB credential for local Worker development.
TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token
# TMDB_API_KEY=your_tmdb_v3_api_key

# Optional enrichment provider.

# Optional Telegram bot (docs/TELEGRAM.md). Local webhooks need a public tunnel.
# TELEGRAM_BOT_TOKEN=123456789:your_bot_token
# TELEGRAM_SETUP_SECRET=your_independent_random_setup_secret
# TELEGRAM_ALLOWED_USERS=12345678

# Optional comma-separated frontend origins beyond the built-in local origins.
# CORS_ALLOWED_ORIGINS=https://yourname.github.io

# Keep local development on the in-memory limiter. Production must use
# ENVIRONMENT=production together with both Cloudflare rate-limit bindings.
ENVIRONMENT=development
