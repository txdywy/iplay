{
  "name": "iplay",
  "version": "1.0.22",
  "private": true,
  "description": "一个懂你的追剧神器：偏好分析 · TMDB 主数据 · 夸克资源直达",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test && npm run lint && npm run build",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='js/**' --test-coverage-include='worker/**'",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:browser:ci": "node tests/browser-smoke-runner.mjs",
    "test:runtime": "node tests/worker-runtime.mjs",
    "test:live": "node tests/live-smoke.mjs",
    "build": "npm run build:css && npm run build:js",
    "deploy:worker:dry-run": "npm run wrangler -- deploy --dry-run --strict",
    "deploy:worker": "npm run wrangler -- deploy --strict --keep-vars",
    "wrangler": "wrangler",
    "build:css": "tailwindcss -i css/input.css -o css/output.css --minify",
    "build:js": "node scripts/build-frontend.mjs",
    "test:performance": "node tests/browser-smoke-runner.mjs tests/browser-performance.mjs",
    "test:performance:worker": "node tests/worker-performance.mjs",
    "test:performance:images": "node tests/browser-smoke-runner.mjs tests/browser-image-performance.mjs",
    "test:performance:search": "node tests/search-performance.mjs",
    "test:performance:parser": "node --expose-gc tests/resource-parser-performance.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txdywy/iplay.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/txdywy/iplay/issues"
  },
  "homepage": "https://iplay.hackx64.eu.org",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.2.4",
    "esbuild": "0.28.2",
    "eslint": "^10.2.1",
    "miniflare": "5.20261023.2-beta",
    "tailwindcss": "^4.2.4",
    "wrangler": "4.155.0"
  }
}
